# OpenRouter is the preferred provider for bondroom
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=recursive/flint-v1.0:free

# Optional aliases if you later use another OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

SITE_URL=http://localhost:4173
SITE_NAME=bondroom
